  "info": {
    "title": "Àjọ API",
    "description": "Business API for the Àjọ web and mobile apps. Amounts are integer minor units sent as strings.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "Ada"
          },
          "botToken": {
            "type": "string",
            "maxLength": 2048,
            "description": "Cloudflare Turnstile token from the sign-up form. Required when bot protection is on; single-use."
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the verification link"
          }
        },
        "required": [
          "token"
        ]
      },
      "VerifiedResponse": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "verified"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the reset link"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "username": {
            "type": "object",
            "nullable": true,
            "example": "ada_ola",
            "description": "Chosen during setup"
          },
          "country": {
            "type": "string",
            "enum": [
              "NG",
              "GB"
            ],
            "nullable": true
          },
          "goal": {
            "type": "string",
            "enum": [
              "solo",
              "circle",
              "both"
            ],
            "nullable": true
          },
          "hasPin": {
            "type": "boolean"
          },
          "onboarded": {
            "type": "boolean",
            "description": "Country, goal, username and PIN are all set"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "emailVerified",
          "mfaEnabled",
          "username",
          "country",
          "goal",
          "hasPin",
          "onboarded"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "NG",
              "GB"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "solo",
              "circle",
              "both"
            ]
          }
        },
        "required": [
          "country",
          "goal"
        ]
      },
      "UsernameAvailableResponse": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ]
      },
      "SetUsernameDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ada_ola",
            "description": "3 to 20 characters: a letter first, then letters, digits or underscores"
          }
        },
        "required": [
          "username"
        ]
      },
      "PinDto": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "string",
            "description": "Six digits"
          }
        },
        "required": [
          "pin"
        ]
      },
      "TokenPairResponse": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "refreshToken"
        ]
      },
      "MfaChallengeResponse": {
        "type": "object",
        "properties": {
          "mfaRequired": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "mfaToken": {
            "type": "string",
            "description": "Single-use token for POST /auth/login/mfa; valid for 5 minutes"
          }
        },
        "required": [
          "mfaRequired",
          "mfaToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginMfaDto": {
        "type": "object",
        "properties": {
          "mfaToken": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "6-digit code from the authenticator app"
          },
          "recoveryCode": {
            "type": "string",
            "description": "One of the saved recovery codes"
          }
        },
        "required": [
          "mfaToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "EnrolMfaResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret to type into an authenticator app"
          },
          "otpauthUri": {
            "type": "string",
            "description": "otpauth:// link for a QR code"
          }
        },
        "required": [
          "secret",
          "otpauthUri"
        ]
      },
      "ConfirmMfaDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "6-digit code from the authenticator app"
          }
        },
        "required": [
          "code"
        ]
      },
      "RecoveryCodesResponse": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "description": "Shown once; each works one time",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recoveryCodes"
        ]
      },
      "DisableMfaDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "6-digit code from the authenticator app"
          }
        },
        "required": [
          "password",
          "code"
        ]
      },
      "MoneyResponse": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Whole number in the currency's smallest unit (kobo, pence, cents)",
            "example": "250000"
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "WalletResponse": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "example": "NGN"
          },
          "available": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "locked": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "savings": {
            "$ref": "#/components/schemas/MoneyResponse"
          }
        },
        "required": [
          "currency",
          "available",
          "locked",
          "savings"
        ]
      },
      "WalletsResponse": {
        "type": "object",
        "properties": {
          "wallets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletResponse"
            }
          }
        },
        "required": [
          "wallets"
        ]
      },
      "TransactionItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this row, also the paging cursor"
          },
          "transactionId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "example": "funding"
          },
          "account": {
            "type": "string",
            "enum": [
              "available",
              "locked",
              "savings"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "currency": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "transactionId",
          "type",
          "account",
          "direction",
          "amount",
          "currency",
          "createdAt"
        ]
      },
      "TransactionsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionItem"
            }
          },
          "next": {
            "type": "object",
            "nullable": true,
            "description": "Pass as `before` for the next page; null at the end"
          }
        },
        "required": [
          "items",
          "next"
        ]
      }
    }
  }
}
