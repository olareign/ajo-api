                      "$ref": "#/components/schemas/MfaChallengeResponse"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The password is right but the email is not confirmed yet (`code: \"email_not_verified\"`). A new confirmation link has been emailed, within the usual limits."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
