# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ajo:ajo@localhost:5432/ajo
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
WEB_APP_URL=http://localhost:3000

# Email provider configuration
# MAIL_PROVIDER: fake (dev/test), smtp (self-hosted SMTP), resend (Resend API)
MAIL_PROVIDER=fake

# SMTP configuration (for EMAILER_MODE=smtp or MAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587  # 587 for STARTTLS, 465 for implicit TLS
# SMTP_SECURE=false  # true for 465, false for 587 (STARTTLS)
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="Àjo <noreply@example.com>"

# Resend configuration (for EMAILER_MODE=resend)
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM="Àjo <noreply@example.com>"

# SUPPORT_EMAIL=support@example.com

# Password security check
# BREACHED_PASSWORD_CHECK: fake (dev/test), hibp (production with Have I Been Pwned API)
BREACHED_PASSWORD_CHECK=fake

# Bot protection on sign-up
# BOT_CHECK: fake (dev/test, passes everything), turnstile (Cloudflare Turnstile; required in production)
BOT_CHECK=fake
# TURNSTILE_SECRET_KEY: the widget's SECRET key (never the site key). For local testing against the real
# service, Cloudflare publishes always-pass and always-fail test secrets in its Turnstile docs.
# TURNSTILE_SECRET_KEY=

# Security keys (auto-generated in development, must be set in production)
# JWT_SECRET: HMAC key for access tokens; at least 32 characters, required in production
# FIELD_ENCRYPTION_KEY: AES-256 key (32 random bytes, base64) for sensitive columns
# Generate with: openssl rand -base64 32

# BFF_SHARED_SECRET: shared with the web app's server (the same value in its BFF_SHARED_SECRET). When set, the
# person's own address and device that the web server reports are used for rate limits, sessions and sign-in
# alerts; unset, they are ignored. At least 32 characters: openssl rand -base64 48
# BFF_SHARED_SECRET=

# Payments. Paystack (Nigeria) is used when its key is set. PAYMENTS_FAKE=true
# uses a stand-in that can pretend to move money, for local work only (refused in production).
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYMENTS_FAKE=true
# PAYMENT_SWEEP_SECONDS=60   # how often held partner messages are retried; 0 turns it off
