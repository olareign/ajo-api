# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ajo:ajo@localhost:5432/ajo
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
WEB_APP_URL=http://localhost:3000
# Stand-ins for local development; production requires resend and hibp.
MAIL_PROVIDER=fake
BREACHED_PASSWORD_CHECK=fake
# RESEND_API_KEY=
# MAIL_FROM="Àjọ <no-reply@example.com>"
# JWT_SECRET is random per process in development; set 32+ characters in production.
# FIELD_ENCRYPTION_KEY is a fixed development key locally; production needs 32 random bytes in base64:
#   openssl rand -base64 32
